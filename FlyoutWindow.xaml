<Window x:Class="QuickMedia.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickMedia" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

  <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Shift"/>
    </Grid.RenderTransform>

    <Border x:Name="Card" Margin="18" Width="380" Padding="14" CornerRadius="12"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrushC}" BorderThickness="1">

      <!-- Yerleşim ApplyLayout() ile stile göre kodda belirlenir -->
      <Grid x:Name="Body">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Plak stilleri: ilerleme halkası -->
        <Grid x:Name="OrbRing" Width="144" Height="144" IsHitTestVisible="False" Visibility="Collapsed">
          <Ellipse x:Name="RingTrack" Width="140" Height="140" Stroke="{DynamicResource TrackBrush}" StrokeThickness="3"/>
          <Path x:Name="RingFill" Stroke="{DynamicResource ProgressBrush}" StrokeThickness="3"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>

        <Border x:Name="ArtBorder" Width="64" Height="64" CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                Background="{DynamicResource SurfaceBrush}">
          <Border.RenderTransform>
            <RotateTransform x:Name="ArtRot"/>
          </Border.RenderTransform>
          <TextBlock x:Name="ArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="26"
                     Foreground="{DynamicResource Text2Brush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Ellipse x:Name="OrbHole" Width="22" Height="22" Visibility="Collapsed" IsHitTestVisible="False"
                 Fill="{DynamicResource SolidBgBrush}" Stroke="{DynamicResource BorderBrushC}" StrokeThickness="1"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border x:Name="Scrim" Background="#8C000000" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Border x:Name="PosterFade" Visibility="Collapsed" IsHitTestVisible="False" Height="120"
                VerticalAlignment="Bottom" CornerRadius="0,0,15,15">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0"/>
              <GradientStop Color="#E0000000" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <StackPanel x:Name="InfoPanel" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="ArtistText" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Text2Brush}"/>
          <Border x:Name="BadgeBorder" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="7,2" CornerRadius="4"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrushC}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <ContentControl x:Name="BadgeIcon" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" IsTabStop="False"/>
              <TextBlock x:Name="BadgeText" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border x:Name="OrbLabel" Visibility="Collapsed" CornerRadius="11" Padding="10,3"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrushC}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="OrbText" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
            <TextBlock x:Name="OrbSub" FontSize="11" MaxWidth="170" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                       Foreground="{DynamicResource Text2Brush}" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <Button x:Name="GearBtn" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                VerticalAlignment="Top" HorizontalAlignment="Right" Content="&#xE713;" ToolTip="Ayarlar"
                Foreground="{DynamicResource Text2Brush}" Click="SettingsBtn_Click"/>

        <StackPanel x:Name="ProgressPanel">
          <!-- Tıkla / sürükle: istediğin bölüme ilerlet -->
          <Grid x:Name="SeekArea" Height="16" Background="Transparent" Cursor="Hand">
            <Grid x:Name="TrackGrid" Height="4" VerticalAlignment="Center" IsHitTestVisible="False">
              <Border CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
              <Border x:Name="Fill" CornerRadius="2" HorizontalAlignment="Left" Width="0"
                      Background="{DynamicResource ProgressBrush}"/>
            </Grid>
          </Grid>
          <Grid x:Name="TimeRow">
            <TextBlock x:Name="PosText" Style="{StaticResource Hint}" Text="0:00"/>
            <TextBlock x:Name="DurText" Style="{StaticResource Hint}" Text="0:00" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="VolumePanel" Orientation="Horizontal">
          <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14"
                  Content="&#xE767;" ToolTip="Bu uygulamanın sesini aç / kapat" Click="MuteBtn_Click"/>
          <Slider x:Name="VolSlider" Width="72" Minimum="0" Maximum="100"
                  Style="{StaticResource FluentSlider}" ValueChanged="VolSlider_ValueChanged"/>
        </StackPanel>

        <StackPanel x:Name="ControlsPanel" Orientation="Horizontal">
          <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Önceki" Click="Prev_Click"/>
          <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Oynat / Duraklat" Click="Play_Click"/>
          <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Sonraki" Click="Next_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Kartın sağ üst köşesinde küçük sabitleme düğmesi (üstüne gelince görünür) -->
    <Button x:Name="PinBtn" Style="{StaticResource PinButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,7,7,0" Content="&#xE718;" ToolTip="Üstte sabitle" Opacity="0" IsHitTestVisible="False"
            Click="Pin_Click"/>
  </Grid>
</Window>
