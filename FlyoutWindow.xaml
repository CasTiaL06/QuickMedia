<Window x:Class="QuickMedia.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickMedia" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

  <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Shift"/>
    </Grid.RenderTransform>

    <Border x:Name="Card" Margin="18" Width="380" Padding="14" CornerRadius="12"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrushC}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.3" Color="Black"/>
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst: kapak + bilgi -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="ArtBorder" Width="64" Height="64" CornerRadius="8" Margin="0,0,12,0"
                  Background="{DynamicResource SurfaceBrush}">
            <TextBlock x:Name="ArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="26"
                       Foreground="{DynamicResource Text2Brush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ArtistText" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Text2Brush}"/>
            <Border x:Name="BadgeBorder" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="7,2" CornerRadius="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushC}" BorderThickness="1">
              <TextBlock x:Name="BadgeText" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
            </Border>
          </StackPanel>

          <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                  VerticalAlignment="Top" Content="&#xE713;" ToolTip="Ayarlar"
                  Foreground="{DynamicResource Text2Brush}" Click="SettingsBtn_Click"/>
        </Grid>

        <!-- İlerleme -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="1" Margin="0,14,0,0">
          <Grid x:Name="TrackGrid" Height="4">
            <Border CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
            <Border x:Name="Fill" CornerRadius="2" HorizontalAlignment="Left" Width="0"
                    Background="{DynamicResource ProgressBrush}"/>
          </Grid>
          <Grid Margin="0,4,0,0">
            <TextBlock x:Name="PosText" Style="{StaticResource Hint}" Text="0:00"/>
            <TextBlock x:Name="DurText" Style="{StaticResource Hint}" Text="0:00" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>

        <!-- Alt: ses + kontroller -->
        <Grid x:Name="BottomRow" Grid.Row="2" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel x:Name="VolumePanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14"
                    Content="&#xE767;" ToolTip="Sesi aç / kapat" Click="MuteBtn_Click"/>
            <Slider x:Name="VolSlider" Width="72" Minimum="0" Maximum="100"
                    Style="{StaticResource FluentSlider}" ValueChanged="VolSlider_ValueChanged"/>
          </StackPanel>

          <StackPanel x:Name="ControlsPanel" Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Önceki" Click="Prev_Click"/>
            <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="20"
                    Width="48" ToolTip="Oynat / Duraklat" Click="Play_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Sonraki" Click="Next_Click"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
