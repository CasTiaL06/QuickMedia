<Window x:Class="QuickMedia.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickMedia Taskbar" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="260" Height="40" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

  <Border x:Name="Hit" CornerRadius="8" Background="Transparent" Padding="6,0,4,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="Art" Width="28" Height="28" CornerRadius="6" Margin="0,0,9,0" VerticalAlignment="Center"
              Background="#22808080">
        <ContentControl x:Name="ArtIcon" HorizontalAlignment="Center" VerticalAlignment="Center" IsTabStop="False"/>
      </Border>

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SubText" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
        <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE892;" Click="Prev_Click"/>
        <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Width="30" Height="26" FontSize="13" Content="&#xE768;" Click="Play_Click"/>
        <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE893;" Click="Next_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
