<Window x:Class="QuickMedia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickMedia" Width="960" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource SolidBgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Background="{DynamicResource SolidSurfaceBrush}"
            BorderBrush="{DynamicResource SolidBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,22,14,16">
        <StackPanel x:Name="BrandHost" DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="QuickMedia" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="BrandSub" Text="Medya flyout" Style="{StaticResource Hint}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="FooterHost" DockPanel.Dock="Bottom"/>
        <Grid x:Name="NavGrid">
          <!-- Seçili sayfayı gösteren, sayfa değişince kayan hap -->
          <Border x:Name="NavPill" Height="38" VerticalAlignment="Top" CornerRadius="6"
                  Background="{DynamicResource AccentSoftBrush}">
            <Border.RenderTransform>
              <TranslateTransform x:Name="NavPillMove"/>
            </Border.RenderTransform>
            <Border Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="0"
                    Background="{DynamicResource AccentBrush}"/>
          </Border>
          <StackPanel x:Name="NavHost"/>
        </Grid>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" ClipToBounds="True">
      <!-- Sol üst köşede çok hafif vurgu ışıltısı -->
      <Ellipse x:Name="Glow" Width="620" Height="620" Margin="-220,-340,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop x:Name="GlowA" Color="#308AB4F8" Offset="0"/>
            <GradientStop x:Name="GlowB" Color="#008AB4F8" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <ContentControl x:Name="PageHost"/>
    </Grid>
  </Grid>
</Window>
