<Window x:Class="QuickMedia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickMedia Ayarlar" Width="860" Height="620" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource SolidBgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sol menü -->
    <Border Background="{DynamicResource SolidSurfaceBrush}" BorderBrush="{DynamicResource SolidBorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="12,20">
        <TextBlock Text="QuickMedia" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,2"/>
        <TextBlock Text="Medya flyout ayarları" Style="{StaticResource Hint}" Margin="10,0,0,20"/>
        <RadioButton Content="Genel"       Tag="PageGeneral"    GroupName="nav" IsChecked="True" Style="{StaticResource Nav}" Click="Nav_Click"/>
        <RadioButton Content="Görünürlük"  Tag="PageVisibility" GroupName="nav" Style="{StaticResource Nav}" Click="Nav_Click"/>
        <RadioButton Content="Platformlar" Tag="PagePlatforms"  GroupName="nav" Style="{StaticResource Nav}" Click="Nav_Click"/>
        <RadioButton Content="Görünüm"     Tag="PageAppearance" GroupName="nav" Style="{StaticResource Nav}" Click="Nav_Click"/>
        <RadioButton Content="Kısayol"     Tag="PageHotkey"     GroupName="nav" Style="{StaticResource Nav}" Click="Nav_Click"/>
        <RadioButton Content="Hakkında"    Tag="PageAbout"      GroupName="nav" Style="{StaticResource Nav}" Click="Nav_Click"/>
      </StackPanel>
    </Border>

    <!-- Sayfalar -->
    <Grid x:Name="Pages" Grid.Column="1">

      <!-- GENEL -->
      <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
          <TextBlock Text="Genel" Style="{StaticResource H1}"/>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="EnabledSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Flyout etkin" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Kapalıyken flyout hiçbir koşulda (kısayol dahil) görünmez."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="AutoStartSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Windows ile başlat" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Oturum açıldığında QuickMedia otomatik çalışsın."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="PortableSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnPortable"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Taşınabilir mod" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Ayarlar exe'nin yanındaki settings.json dosyasında tutulur. Klasörü USB belleğe kopyalayıp her yerde çalıştırabilirsiniz."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource FluentButton}" Content="Klasörü aç" VerticalAlignment="Center" Click="OpenFolder_Click"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Ayar dosyası konumu" FontWeight="SemiBold"/>
              <TextBlock x:Name="PathText" Style="{StaticResource Hint}"/>
            </StackPanel>
          </DockPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <!-- GÖRÜNÜRLÜK -->
      <ScrollViewer x:Name="PageVisibility" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="28,24">
          <TextBlock Text="Görünürlük koşulları" Style="{StaticResource H1}"/>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="TrackSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Parça değişince göster" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Yeni şarkı / video başladığında flyout açılır."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="PlaySw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Oynat / duraklat olunca göster" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Oynatma durumu değiştiğinde flyout açılır."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="FullscreenSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Tam ekranda gizle" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Oyun, tam ekran video veya sunum sırasında otomatik gösterme yapılmaz. Kısayol yine de çalışır."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="PausedSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Duraklatılınca gizle ('Hep göster' modunda)" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Sürekli görünen platformlarda medya duraklatılırsa flyout kapanır."/>
            </StackPanel>
          </DockPanel></Border>

          <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,12"
                     Text="Her platform için süre ve davranışı 'Platformlar' sayfasından ayarlayabilirsiniz."/>
          <Button Style="{StaticResource FluentButton}" Content="Önizleme göster" HorizontalAlignment="Left" Click="Preview_Click"/>
        </StackPanel>
      </ScrollViewer>

      <!-- PLATFORMLAR -->
      <ScrollViewer x:Name="PagePlatforms" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="28,24">
          <TextBlock Text="Platformlar" Style="{StaticResource H1}"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,-8,0,14"
                     Text="Hep göster: medya varken sürekli açık kalır. Süreli: tetiklenince belirlenen saniye kadar görünür. Gizle: bu platformda hiç otomatik açılmaz. Listede olmayan kaynaklar 'Diğer' kuralını kullanır."/>
          <StackPanel x:Name="PlatformList"/>
          <Button Style="{StaticResource FluentButton}" Content="Tümünü varsayılana döndür" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetRules_Click"/>
        </StackPanel>
      </ScrollViewer>

      <!-- GÖRÜNÜM -->
      <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="28,24">
          <TextBlock Text="Görünüm" Style="{StaticResource H1}"/>

          <Border Style="{StaticResource Card}"><DockPanel>
            <Border DockPanel.Dock="Right" Background="{DynamicResource SolidBgBrush}" CornerRadius="8" Padding="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeDark"  GroupName="theme" Content="Dark Glass"  Style="{StaticResource Seg}" Click="OnChanged"/>
                <RadioButton x:Name="ThemeLight" GroupName="theme" Content="Light Glass" Style="{StaticResource Seg}" Click="OnChanged"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Tema" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Dark Glass: yarı saydam koyu yüzey, ince kenarlık, yumuşak gölge."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <StackPanel x:Name="AccentPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Vurgu rengi" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="İlerleme çubuğu ve seçili öğeler. Varsayılan: #8AB4F8"/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider x:Name="OpacitySlider" DockPanel.Dock="Right" Width="170" Minimum="30" Maximum="100" Style="{StaticResource FluentSlider}" VerticalAlignment="Center" ValueChanged="OnSlider"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Arka plan opaklığı" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Varsayılan %80 (#CC171B24)."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="BlurSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Arka plan bulanıklığı" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Masaüstü duvar kâğıdını hafifçe bulanıklaştırır."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><DockPanel>
            <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider x:Name="ScaleSlider" DockPanel.Dock="Right" Width="170" Minimum="70" Maximum="160" Style="{StaticResource FluentSlider}" VerticalAlignment="Center" ValueChanged="OnSlider"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Boyut" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" Text="Flyout üzerindeyken Ctrl + fare tekerleği ile de büyütüp küçültebilirsiniz."/>
            </StackPanel>
          </DockPanel></Border>

          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Konum" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="Hazır konumlardan birini seçin veya flyout'u fareyle sürükleyerek istediğiniz yere taşıyın."/>
            <Border Background="{DynamicResource SolidBgBrush}" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
              <UniformGrid x:Name="PositionGrid" Columns="3">
                <RadioButton GroupName="pos" Tag="TopLeft"      Content="Üst Sol"   Style="{StaticResource Seg}" Click="OnPosition"/>
                <RadioButton GroupName="pos" Tag="TopCenter"    Content="Üst Orta"  Style="{StaticResource Seg}" Click="OnPosition"/>
                <RadioButton GroupName="pos" Tag="TopRight"     Content="Üst Sağ"   Style="{StaticResource Seg}" Click="OnPosition"/>
                <RadioButton GroupName="pos" Tag="BottomLeft"   Content="Alt Sol"   Style="{StaticResource Seg}" Click="OnPosition"/>
                <RadioButton GroupName="pos" Tag="BottomCenter" Content="Alt Orta"  Style="{StaticResource Seg}" Click="OnPosition"/>
                <RadioButton GroupName="pos" Tag="BottomRight"  Content="Alt Sağ"   Style="{StaticResource Seg}" Click="OnPosition"/>
              </UniformGrid>
            </Border>
          </StackPanel></Border>

          <TextBlock Text="Gösterilecek öğeler" FontWeight="SemiBold" Margin="2,10,0,8"/>

          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="ArtSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <TextBlock Text="Albüm kapağı" VerticalAlignment="Center"/>
          </DockPanel></Border>
          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="ProgSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <TextBlock Text="İlerleme çubuğu" VerticalAlignment="Center"/>
          </DockPanel></Border>
          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="CtrlSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <TextBlock Text="Oynat / önceki / sonraki düğmeleri" VerticalAlignment="Center"/>
          </DockPanel></Border>
          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="VolSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Ses aç / kapat ve ses seviyesi"/>
              <TextBlock Style="{StaticResource Hint}" Text="Sistem ana sesini sessize alır / ayarlar."/>
            </StackPanel>
          </DockPanel></Border>
          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="BadgeSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <TextBlock Text="Platform etiketi" VerticalAlignment="Center"/>
          </DockPanel></Border>
          <Border Style="{StaticResource Card}"><DockPanel>
            <CheckBox x:Name="AnimSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged"/>
            <TextBlock Text="Açılış / kapanış animasyonu" VerticalAlignment="Center"/>
          </DockPanel></Border>

          <Button Style="{StaticResource FluentButton}" Content="Önizleme göster" HorizontalAlignment="Left" Margin="0,6,0,0" Click="Preview_Click"/>
        </StackPanel>
      </ScrollViewer>

      <!-- KISAYOL -->
      <ScrollViewer x:Name="PageHotkey" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="28,24">
          <TextBlock Text="Kısayol" Style="{StaticResource H1}"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Göster / gizle kısayolu" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                       Text="Kutuya tıklayıp istediğiniz tuş kombinasyonuna basın (en az bir Ctrl, Alt veya Win ile). Varsayılan: Alt + P"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="HotkeyBtn" Style="{StaticResource FluentButton}" MinWidth="200" Padding="14,9" FontWeight="SemiBold" Click="HotkeyBtn_Click"/>
              <Button Style="{StaticResource FluentButton}" Content="Sıfırla (Alt + P)" Margin="8,0,0,0" Click="HotkeyReset_Click"/>
            </StackPanel>
            <TextBlock x:Name="HotkeyStatus" Margin="0,10,0,0" Style="{StaticResource Hint}"/>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <!-- HAKKINDA -->
      <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="28,24">
          <TextBlock Text="Hakkında" Style="{StaticResource H1}"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="QuickMedia" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,2,0,10"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Windows'un küresel medya kontrollerini (SMTC) dinleyen, Fluent tasarımlı minimal bir medya flyout'udur. Spotify, YouTube, Netflix, X, Instagram gibi kaynaklar otomatik tanınır; tanınmayanlar 'Diğer' kuralını kullanır. Web siteleri tarayıcı pencere başlığına bakılarak tahmin edilir."/>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>
</Window>
