<Window x:Class="QuickMedia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickMedia" Width="900" Height="660" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource SolidBgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="214"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Background="{DynamicResource SolidSurfaceBrush}"
            BorderBrush="{DynamicResource SolidBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,20,12,16">
        <StackPanel x:Name="BrandHost" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="QuickMedia" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Ayarlar" Style="{StaticResource Hint}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="NavHost"/>
      </DockPanel>
    </Border>

    <ContentControl x:Name="PageHost" Grid.Column="1"/>
  </Grid>
</Window>
